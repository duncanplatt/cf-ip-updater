// Public, generic config. Keep real hostnames, routes, and zone IDs out of this file:
// copy it to wrangler.local.jsonc (gitignored), add your route there, and run `npm run deploy:local`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ip-updater",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  // Example route (put this in wrangler.local.jsonc, not here):
  // "routes": [{ "pattern": "api.example.com/v1/ddns/*", "zone_name": "example.com" }],
  "secrets": {
    // CF_API_TOKEN: Cloudflare API token with Zone > DNS > Edit on the zone(s) you update.
    // DDNS_CLIENTS: JSON describing router logins and the hostnames each may update.
    "required": ["CF_API_TOKEN", "DDNS_CLIENTS"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
